# Build Outputs & APKs
app/build/
*.apk
# The published release files must stay tracked; "!website/update/" alone does not re-include
# files already matched by *.apk, which made the owner's commits delete the APK.
!website/update/
!website/update/*.apk
!website/update/*.bin

# Build caches
.pio/
__pycache__/
*.pyc

# Super-admin signing keys must never be committed
*.key
*.pem
__pycache__/
*.pyc
