# Binaries must never go through text or line-ending conversion: a mangled firmware image fails
# the ESP32 bootloader's magic-byte check and breaks every OTA update.
*.bin binary
*.apk binary

# Router scripts must keep Unix line endings: a carriage return in a shebang line or a script breaks it on OpenWrt.
opennds/*.sh text eol=lf
opennds/*.init text eol=lf
opennds/*.conf text eol=lf
scripts/*.sh text eol=lf
opennds/tests/*.sh text eol=lf

# Router scripts must keep LF line endings or the router cannot run them (CRLF gives ": not found" errors)
*.sh text eol=lf
*.init text eol=lf
*.sh.in text eol=lf
setup/piso-setup.sh text eol=lf
