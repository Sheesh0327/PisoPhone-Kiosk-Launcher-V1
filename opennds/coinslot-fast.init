#!/bin/sh /etc/rc.common
# OpenWrt service for the EXPERIMENTAL MicroPython edition (procd). Installed as /etc/init.d/coinslot in place of
# coinslot.init. One resident process serves the local API, the live-update stream and the fair-use watcher, so there
# is a single supervised instance (the shell edition has three).
START=99
USE_PROCD=1

start_service() {
	mkdir -p /etc/coinslot.d/vouchers

	procd_open_instance fast
	procd_set_param command /usr/bin/coinslot-fast.sh serve
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
