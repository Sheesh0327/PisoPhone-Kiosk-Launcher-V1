#!/bin/sh /etc/rc.common
# OpenWrt service for the coin-slot manager (procd). Installed as /etc/init.d/coinslot.
# Two supervised processes: the local listener the portal talks to, and the HyperSpeed fair-use watcher.
START=99
USE_PROCD=1

start_service() {
	mkdir -p /etc/coinslot.d/vouchers

	procd_open_instance listener
	procd_set_param command /usr/bin/coinslot-listener.sh serve
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance fairuse
	procd_set_param command /usr/bin/coinslot-listener.sh fairuse
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
